{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/my-case-grid",
	"version": "0.1.0",
	"title": "Kundcase-rutnät",
	"category": "beegleton-content",
	"icon": "grid-view",
	"description": "Rutnät eller karusell med kundcase, valfritt filtrerat på kategori.",
	"keywords": [
		"kundcase",
		"case",
		"rutnät",
		"karusell"
	],
	"example": {},
	"attributes": {
		"postsPerPage": {
			"type": "number",
			"default": 6
		},
		"showButton": {
			"type": "boolean",
			"default": true
		},
		"selectedCategories": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		},
		"isCarousel": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"interactivity": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
