{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/label",
	"version": "0.1.0",
	"title": "Etikett",
	"category": "beegleton-content",
	"icon": "tag",
	"description": "Liten handritad etikett med text.",
	"keywords": [
		"etikett",
		"label",
		"tagg"
	],
	"example": {
		"attributes": {
			"text": "Etikett"
		}
	},
	"attributes": {
		"text": {
			"type": "string",
			"source": "html",
			"selector": ".label-text",
			"default": ""
		},
		"svgColor": {
			"type": "string",
			"default": "#3B3632"
		},
		"textColor": {
			"type": "string",
			"default": "#3B3632"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
