{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/my-bee-flight-container",
	"version": "0.1.0",
	"title": "Container med flygande bi",
	"category": "beegleton-layout",
	"icon": "buddicons-activity",
	"description": "Sektion där ett bi flyger i mjuka kurvor bakom innehållet när man scrollar.",
	"keywords": [
		"container",
		"sektion",
		"bi",
		"animation",
		"scroll"
	],
	"example": {
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"content": "Rubrik"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Ett bi flyger bakom innehållet när man scrollar förbi."
				}
			}
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"beeColor": {
			"type": "string",
			"default": "#3B3632"
		},
		"beeSize": {
			"type": "number",
			"default": 64
		},
		"showOnMobile": {
			"type": "boolean",
			"default": true
		},
		"showTrail": {
			"type": "boolean",
			"default": true
		},
		"landOnButton": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"layout": {
			"default": {
				"type": "constrained"
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"gradients": true,
			"text": true
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
