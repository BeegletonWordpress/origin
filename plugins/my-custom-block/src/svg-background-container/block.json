{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/my-svg-background-container",
	"version": "0.1.0",
	"title": "Container med bakgrundsform",
	"category": "beegleton-layout",
	"icon": "cover-image",
	"description": "Sektion med en stor handritad form (Splash eller Penseldrag) bakom valfritt innehåll.",
	"keywords": [
		"container",
		"sektion",
		"form",
		"bakgrund",
		"svg",
		"splash",
		"penseldrag"
	],
	"example": {
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"content": "Rubrik över formen",
					"textAlign": "center"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Valfritt innehåll ovanpå bakgrundsformen."
				}
			}
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"svgColor": {
			"type": "string",
			"default": "#edb239"
		},
		"showOnMobile": {
			"type": "boolean",
			"default": false
		},
		"shape": {
			"type": "string",
			"default": "splash"
		},
		"drawAnimation": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"layout": {
			"default": {
				"type": "constrained"
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"gradients": true,
			"text": true
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
