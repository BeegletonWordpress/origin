{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/my-header-block",
	"version": "0.1.0",
	"title": "Sidhuvud",
	"category": "beegleton-site",
	"icon": "layout",
	"description": "Webbplatsens sidhuvud med logotyp och meny. Används i mallen för sidhuvudet.",
	"keywords": [
		"sidhuvud",
		"header",
		"meny"
	],
	"supports": {
		"align": [
			"full"
		],
		"color": {
			"background": true,
			"text": false,
			"gradients": false
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"position": {
			"sticky": true
		},
		"html": false
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"backgroundColor": {
			"type": "string"
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30"
					}
				}
			}
		},
		"scrolledLogoId": {
			"type": "number"
		},
		"scrolledLogoUrl": {
			"type": "string"
		},
		"darkLogoId": {
			"type": "number"
		},
		"darkLogoUrl": {
			"type": "string"
		},
		"lightLogoId": {
			"type": "number"
		},
		"lightLogoUrl": {
			"type": "string"
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": [
		"file:./index.css",
		"file:./style-index.css"
	],
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js"
}
