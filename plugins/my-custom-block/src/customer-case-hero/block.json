{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/customer-case-hero",
	"version": "0.1.0",
	"title": "Customer Case Hero",
	"category": "theme",
	"icon": "welcome-widgets-menus",
	"description": "A hero block for customer case study pages.",
	"supports": {
		"html": false,
		"align": ["full", "wide"],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"tags": {
			"type": "array",
			"default": []
		},
		"svgColor": {
			"type": "string"
		},
		"reverseLayout": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
