{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/customer-case-hero",
	"version": "0.1.0",
	"title": "Kundcasets hjälte",
	"category": "beegleton-hero",
	"icon": "welcome-widgets-menus",
	"description": "Toppsektion för kundcase med casets titel, tagline och bild.",
	"keywords": [
		"hero",
		"kundcase",
		"case",
		"topp"
	],
	"example": {
		"attributes": {
			"tagline": "Så hjälpte vi kunden"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"full",
			"wide"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"tagline": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": "https://beegleton-dev.local/wp-content/uploads/2026/03/Rectangle-4.png"
		},
		"imageAlt": {
			"type": "string",
			"default": "Customer Case Hero Image"
		},
		"imageId": {
			"type": "number"
		},
		"svgColor": {
			"type": "string"
		},
		"reverseLayout": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
