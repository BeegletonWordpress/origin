{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "my-custom-block/animation-arrow",
	"version": "0.1.0",
	"title": "Animerad pil",
	"category": "beegleton-content",
	"icon": "arrow-right-alt",
	"description": "Handritad pil som ritas fram vid scroll.",
	"keywords": [
		"pil",
		"arrow",
		"animation"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"layout": {
			"allowEditing": true,
			"allowInheriting": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"backgroundColor": {
			"type": "string"
		},
		"style": {
			"type": "object"
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"viewScript": "file:./view.js"
}
