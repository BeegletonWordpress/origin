{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/scroll-section",
	"version": "0.1.0",
	"title": "Scroll Section",
	"category": "theme",
	"icon": "editor-insertmore",
	"description": "One content section with its own image, used inside the Scroll Sections block.",
	"parent": ["create-block/scroll-sections"],
	"attributes": {
		"image": {
			"type": "object"
		},
		"dividerColor": {
			"type": "string"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
} 