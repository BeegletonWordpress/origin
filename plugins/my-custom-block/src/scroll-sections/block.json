{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/scroll-sections",
	"version": "0.1.0",
	"title": "Scrollsektioner",
	"category": "beegleton-layout",
	"icon": "align-pull-left",
	"description": "Sektioner som byts ut när man scrollar.",
	"keywords": [
		"scroll",
		"sektioner",
		"animation"
	],
	"attributes": {
		"image": {
			"type": "object"
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
