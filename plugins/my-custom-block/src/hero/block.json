{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/hero",
	"version": "0.1.0",
	"title": "Startsidans hjälte",
	"category": "beegleton-hero",
	"icon": "welcome-widgets-menus",
	"description": "Startsidans toppsektion med rubrik, text, knapp och bildcollage.",
	"keywords": [
		"hero",
		"topp",
		"startsida",
		"bild"
	],
	"example": {
		"innerBlocks": []
	},
	"supports": {
		"html": false,
		"align": [
			"full",
			"wide"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"svgColor": {
			"type": "string",
			"default": "#EDB239"
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js"
}
