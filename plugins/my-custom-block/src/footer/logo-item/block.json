{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/my-footer-logo-item",
	"version": "0.1.0",
	"title": "Sidfotslogotyp",
	"category": "beegleton-site",
	"icon": "layout",
	"description": "En logotyp i sidfoten.",
	"keywords": [
		"sidfot",
		"logotyp"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"mediaUrl": {
			"type": "string",
			"source": "attribute",
			"selector": "img",
			"attribute": "src"
		},
		"mediaId": {
			"type": "number"
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": [
		"file:./index.css",
		"file:./style-index.css"
	],
	"viewScript": "file:./view.js",
	"parent": [
		"create-block/my-footer-logos"
	]
}
