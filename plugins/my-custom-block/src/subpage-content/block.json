{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/subpage-content",
	"version": "0.1.0",
	"title": "Undersidans innehåll",
	"category": "beegleton-layout",
	"icon": "layout",
	"description": "Innehållsdelen i undersidesmallen.",
	"keywords": [
		"innehåll",
		"undersida"
	],
	"supports": {
		"html": false,
		"align": [
			"full",
			"wide"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"alignment": {
			"type": "string",
			"default": "full"
		}
	},
	"textdomain": "my-custom-block",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}
