{
	"apiVersion": 3,
	"name": "create-block/service-block",
	"title": "Service Block",
	"editorScript": "file:./index.js",
	"style": ["file:./index.css", "file:./style-index.css"],
	"editorStyle": "file:./editor.css",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Titel"
		},
		"description": {
			"type": "string",
			"default": "Beskrivning av tjänsten..."
		},
		"themeColor": {
			"type": "string",
			"default": "#bbc7e7"
		},
		"illustrationSvg": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"spacing": {
			"padding": true,
			"margin": true
		}
	}
}
